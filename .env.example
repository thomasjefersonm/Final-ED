# Copie para .env (cp .env.example .env). O .env NÃO vai para o GitHub.

# -----------------------------------------------------------------------------
# PostgreSQL de origem (OLTP normalizado - TSE Presidente 2026)
# -----------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=eleicao_2026_arq
PG_USER=
PG_PASSWORD=
PG_SCHEMA=public

# -----------------------------------------------------------------------------
# MinIO (Data Lake / object storage S3)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9021
MINIO_ENDPOINT=http://localhost:9020

# Buckets da arquitetura medalhão (criados pelo serviço minio-init)
MINIO_BUCKETS=landing bronze silver gold
MINIO_LANDING_BUCKET=landing
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold
